---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { getNavigation, getSiteSettings, getUi } from '../data';
import { localizePath, t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi();
const settings = getSiteSettings();
const { footer } = getNavigation();
const { contact } = settings;

// Placeholders stay visible as text but are not turned into broken tel:/mailto: links.
const isPlaceholder = (value: string) => value.startsWith('[');
const year = new Date().getFullYear();
---

<footer class="on-dark bg-navy text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-2 lg:grid-cols-4 lg:px-8 lg:py-16">
    <div class="lg:col-span-1">
      <a href={localizePath('', locale)} aria-label={t(ui.homeLink, locale)} class="inline-block">
        <Logo locale={locale} tone="dark" />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-silver">{t(settings.description, locale)}</p>
      <WhatsAppButton locale={locale} class="mt-6 text-sm" />
    </div>

    <nav aria-label={t(ui.footerNav, locale)}>
      <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-orange-light">{t(ui.footerPages, locale)}</h2>
      <ul class="mt-4 space-y-1">
        {
          footer.map((item) => (
            <li>
              <a href={localizePath(item.href, locale)} class="inline-flex min-h-11 items-center text-white hover:underline">
                {t(item.label, locale)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-orange-light">{t(ui.footerContact, locale)}</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex items-center gap-3">
          <Icon name="phone" class="size-4 shrink-0 text-silver" />
          {
            isPlaceholder(contact.phone) ? (
              <span>{contact.phone}</span>
            ) : (
              <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="inline-flex min-h-11 items-center hover:underline">{contact.phone}</a>
            )
          }
        </li>
        <li class="flex items-center gap-3">
          <Icon name="mail" class="size-4 shrink-0 text-silver" />
          {
            isPlaceholder(contact.email) ? (
              <span>{contact.email}</span>
            ) : (
              <a href={`mailto:${contact.email}`} class="inline-flex min-h-11 items-center hover:underline">{contact.email}</a>
            )
          }
        </li>
        <li class="flex gap-3">
          <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-silver" />
          <span>{t(contact.address, locale)}</span>
        </li>
        <li class="flex gap-3">
          <Icon name="clock" class="mt-0.5 size-4 shrink-0 text-silver" />
          <span>{t(contact.hours, locale)}</span>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-orange-light">{t(ui.footerGroup, locale)}</h2>
      <p class="mt-4 text-sm leading-relaxed text-silver">{t(ui.footerGroupText, locale)}</p>
      <a href={localizePath('vision-group', locale)} class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-white underline decoration-orange decoration-2 underline-offset-4">
        {t(ui.footerGroupLink, locale)}
      </a>
    </div>
  </div>

  <div class="border-t border-white/15">
    <p class="mx-auto max-w-7xl px-4 py-5 text-xs text-silver sm:px-6 lg:px-8">
      &copy; {year} {settings.companyName}. {t(ui.rights, locale)}
    </p>
  </div>
</footer>
