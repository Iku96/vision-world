---
import Photo from './Photo.astro';
import StatusBadge from './StatusBadge.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { getUi } from '../data';
import { formatTZS, localizePath, t } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import type { Listing } from '../data/types';

interface Props {
  listing: Listing;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { listing, locale, headingLevel: Heading = 'h3' } = Astro.props;
const ui = getUi();
const title = t(listing.title, locale);
const sold = listing.status === 'sold';
const price = listing.price.type === 'fixed' ? formatTZS(listing.price.amountTZS, locale) : t(ui.priceOnRequest, locale);
const message = t(sold ? ui.similarMessage : ui.listingMessage, locale).replace('{title}', title);
const image = listing.images[0] ?? { src: '', alt: listing.title };
const href = localizePath(`stock/${listing.slug.current}`, locale);
---

<article class="lift flex h-full flex-col overflow-hidden rounded-md border border-silver bg-white">
  <a href={href} class="relative block" tabindex="-1" aria-hidden="true">
    <Photo
      image={image}
      locale={locale}
      framed={false}
      sizes="(min-width: 1280px) 400px, (min-width: 768px) 33vw, 100vw"
      class:list={[sold && 'opacity-60']}
    />
    <StatusBadge status={listing.status} locale={locale} class="absolute top-3 left-3" />
  </a>
  <div class="flex flex-1 flex-col p-5">
    <Heading class="text-lg font-bold">
      <a href={href} class="-my-2 block py-2 hover:underline">{title}</a>
    </Heading>
    <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
      {
        listing.specs.map((spec) => (
          <div>
            <dt class="text-slate-600">{t(spec.label, locale)}</dt>
            <dd class="font-medium">{t(spec.value, locale)}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 font-heading text-xl font-extrabold text-navy">{price}</p>
    <WhatsAppButton
      locale={locale}
      message={message}
      label={t(sold ? ui.askAboutSimilar : ui.askAboutListing, locale)}
      class="mt-4 w-full"
    />
    <a
      href={href}
      class="mt-2 inline-flex min-h-11 items-center justify-center gap-1.5 rounded-md font-semibold text-globe-dark hover:underline"
    >
      {t(ui.viewDetails, locale)}
    </a>
  </div>
</article>
