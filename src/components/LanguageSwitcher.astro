---
import { getUi } from '../data';
import { localeMeta, locales, type Locale } from '../i18n/config';
import { isPublished, localizePath, stripLocale, t } from '../i18n/utils';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
const ui = getUi();
const path = stripLocale(Astro.url.pathname);
---

<div class:list={['flex items-center text-sm font-semibold', className]} role="group" aria-label={t(ui.language, locale)}>
  {
    locales.map((l, i) => {
      const meta = localeMeta[l];
      return (
        <>
          {i > 0 && <span class="px-1 text-silver" aria-hidden="true">/</span>}
          {l === locale ? (
            <span class="px-1.5 py-2 text-navy" aria-current="true">
              <abbr title={meta.name} class="no-underline">{meta.label}</abbr>
            </span>
          ) : isPublished(l) ? (
            <a href={localizePath(path, l)} hreflang={meta.htmlLang} lang={meta.htmlLang} class="px-1.5 py-2 text-globe-dark hover:underline">
              {meta.label}
            </a>
          ) : (
            <span
              class="cursor-not-allowed px-1.5 py-2 text-slate-500"
              title={`${meta.name}: ${t(ui.languageComingSoon, locale)}`}
            >
              <span aria-hidden="true">{meta.label}</span>
              <span class="sr-only">{`${meta.name}, ${t(ui.languageComingSoon, locale)}`}</span>
            </span>
          )}
        </>
      );
    })
  }
</div>
