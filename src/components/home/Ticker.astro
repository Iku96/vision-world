---
// Slim orange band with the category names drifting past. CSS only: pauses on hover,
// and for reduced motion it stands still and can be swiped instead.
import { getCategories } from '../../data';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const names = getCategories().map((c) => t(c.title, locale));
---

<div class="ticker overflow-hidden border-y border-orange-light bg-orange text-navy">
  <div class="ticker-track flex w-max">
    {
      [false, true].map((copy) => (
        <ul class="flex shrink-0 items-center" aria-hidden={copy ? 'true' : undefined}>
          {names.map((name) => (
            <li class="flex items-center gap-6 py-3 pr-6 font-heading text-sm font-bold tracking-wider whitespace-nowrap uppercase sm:text-base">
              {name}
              <span class="size-1.5 rounded-full bg-navy" aria-hidden="true" />
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .ticker-track {
      animation: ticker 45s linear infinite;
    }

    .ticker:hover .ticker-track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker {
      overflow-x: auto;
    }
  }

  /* Two identical lists, so sliding by half loops seamlessly. */
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
</style>
