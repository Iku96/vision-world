---
import ListingCard from '../ListingCard.astro';
import SectionHeader from '../SectionHeader.astro';
import { getFeaturedListings, getHomePage } from '../../data';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { stock } = getHomePage();
const listings = getFeaturedListings(3);
---

{
  listings.length > 0 && (
    <section aria-labelledby="stock-heading" class="bg-mist py-14 lg:py-24">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <SectionHeader copy={stock} locale={locale} id="stock-heading" />
        <ul class="mt-8 grid gap-5 md:grid-cols-3 lg:mt-12 lg:gap-6">
          {listings.map((listing) => (
            <li>
              <ListingCard listing={listing} locale={locale} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
