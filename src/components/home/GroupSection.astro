---
import SectionHeader from '../SectionHeader.astro';
import { getDivisions, getHomePage, getUi } from '../../data';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { group } = getHomePage();
const ui = getUi();
const divisions = getDivisions();
---

<section aria-labelledby="group-heading" class="bg-white py-14 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader copy={group} locale={locale} id="group-heading" />
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 xl:grid-cols-5">
      {
        divisions.map((division) => (
          <li class="flex flex-col rounded-md border border-silver p-5">
            {division.status === 'comingSoon' && (
              <span class="self-start rounded bg-orange-light px-2 py-0.5 text-xs font-bold tracking-wider text-ink uppercase">
                {t(ui.comingSoon, locale)}
              </span>
            )}
            <h3 class="mt-4 text-lg leading-snug font-bold">{division.name}</h3>
            <p class="mt-2 text-sm text-slate-600">{t(division.description, locale)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
