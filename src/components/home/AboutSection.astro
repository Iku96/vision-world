---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { getHomePage } from '../../data';
import { localizePath, t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { about } = getHomePage();
---

<section aria-labelledby="about-heading" class="bg-mist py-14 lg:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16 lg:px-8">
    <div class="mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
      <Photo image={about.image} locale={locale} ratio="4 / 5" sizes="(min-width: 1024px) 480px, 384px" class="rounded-md" />
    </div>
    <div class="lg:col-span-7">
      <p class="flex items-center gap-2 text-sm font-semibold tracking-wider text-globe-dark uppercase">
        <span class="h-0.5 w-6 bg-orange" aria-hidden="true"></span>
        {t(about.eyebrow, locale)}
      </p>
      <h2 id="about-heading" class="mt-3 text-3xl font-extrabold sm:text-4xl">{t(about.heading, locale)}</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-700">{t(about.text, locale)}</p>
      <figure class="mt-8 border-l-4 border-orange pl-5">
        <blockquote class="font-heading text-xl leading-snug font-bold text-navy sm:text-2xl">
          <p>{t(about.quote, locale)}</p>
        </blockquote>
        <figcaption class="mt-3 text-sm">
          <span class="font-semibold">{about.quoteName}</span>, {t(about.quoteRole, locale)}
        </figcaption>
      </figure>
      {
        about.link && (
          <a
            href={localizePath(about.link.href, locale)}
            class="mt-8 inline-flex min-h-11 items-center gap-1.5 font-semibold text-globe-dark hover:underline"
          >
            {t(about.link.label, locale)}
            <Icon name="arrowRight" class="size-4" />
          </a>
        )
      }
    </div>
  </div>
</section>
