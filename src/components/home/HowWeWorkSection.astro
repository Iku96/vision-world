---
import SectionHeader from '../SectionHeader.astro';
import { getBuyerJourney, getHomePage, getUi } from '../../data';
import { t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { howWeWork } = getHomePage();
const ui = getUi();
const steps = getBuyerJourney();
---

<section aria-labelledby="how-heading" class="bg-white py-14 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader copy={howWeWork} locale={locale} id="how-heading" />
    <ol class="mt-10 grid gap-8 lg:mt-14 lg:grid-cols-4 lg:gap-6">
      {
        steps.map((step, i) => (
          <li class="relative pl-16 lg:pl-0">
            {/* Orange route segment to the next step: vertical on mobile, horizontal on desktop. */}
            {i < steps.length - 1 && (
              <span
                class="absolute top-10 -bottom-8 left-5 w-0.5 bg-orange lg:top-5 lg:-right-6 lg:bottom-auto lg:left-10 lg:h-0.5 lg:w-auto"
                aria-hidden="true"
              />
            )}
            <span
              class="absolute top-0 left-0 flex size-10 items-center justify-center rounded-full bg-navy font-heading font-bold text-white lg:relative"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="pt-1.5 text-xl font-bold lg:mt-5 lg:pt-0">
              <span class="sr-only">{`${t(ui.step, locale)} ${i + 1}: `}</span>
              {t(step.title, locale)}
            </h3>
            <p class="mt-2 leading-relaxed text-slate-700">{t(step.description, locale)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
