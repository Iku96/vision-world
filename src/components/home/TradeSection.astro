---
import CategoryCard from '../CategoryCard.astro';
import SectionHeader from '../SectionHeader.astro';
import { getCategories, getHomePage } from '../../data';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { trade } = getHomePage();
const categories = getCategories();
---

<section aria-labelledby="trade-heading" class="bg-white py-14 lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader copy={trade} locale={locale} id="trade-heading" />
    <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-12 lg:grid-cols-4 lg:gap-6">
      {
        categories.map((category) => (
          <li>
            <CategoryCard category={category} locale={locale} />
          </li>
        ))
      }
    </ul>
  </div>
</section>
