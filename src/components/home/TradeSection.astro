---
// Categories as tall photo cards on navy. Phones: a swipeable row (scroll snap, no JS).
// Desktop: a grid with the first category as a large feature card.
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { getCategories, getHomePage, getUi } from '../../data';
import { localizePath, t } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomePage().trade;
const categories = getCategories();
const ui = getUi();
---

<section aria-labelledby="trade-heading" class="on-dark overflow-hidden bg-navy py-14 text-white lg:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between md:gap-8">
      <div class="max-w-2xl">
        <p class="flex items-center gap-2 text-sm font-semibold tracking-wider text-orange-light uppercase">
          <span class="h-0.5 w-6 bg-orange" aria-hidden="true"></span>
          {t(copy.eyebrow, locale)}
        </p>
        <h2 id="trade-heading" class="mt-3 text-3xl font-extrabold text-white sm:text-4xl">{t(copy.heading, locale)}</h2>
        {copy.intro && <p class="mt-3 text-lg text-white/80">{t(copy.intro, locale)}</p>}
      </div>
      {
        copy.link && (
          <a
            href={localizePath(copy.link.href, locale)}
            class="inline-flex min-h-11 shrink-0 items-center gap-1.5 font-semibold text-orange-light hover:underline"
          >
            {t(copy.link.label, locale)}
            <Icon name="arrowRight" class="size-4" />
          </a>
        )
      }
    </div>

    <ul
      class="-mx-4 mt-8 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:-mx-6 sm:px-6 lg:mx-0 lg:mt-12 lg:grid lg:auto-rows-[15rem] lg:grid-cols-4 lg:gap-4 lg:overflow-visible lg:px-0 lg:pb-0"
    >
      {
        categories.map((category, i) => {
          const feature = i === 0;
          return (
            <li
              class:list={[
                'h-[22rem] w-[72vw] max-w-[18rem] shrink-0 snap-start lg:h-auto lg:w-auto lg:max-w-none',
                feature && 'lg:col-span-2 lg:row-span-2',
              ]}
            >
              <a
                href={localizePath(`what-we-trade/${category.slug.current}`, locale)}
                class="lift group relative block h-full overflow-hidden rounded-md bg-navy-dark"
              >
                <div class="zoom-img absolute inset-0">
                  <Photo
                    image={category.image}
                    locale={locale}
                    framed={false}
                    sizes={feature ? '(min-width: 1280px) 600px, (min-width: 1024px) 50vw, 72vw' : '(min-width: 1280px) 300px, (min-width: 1024px) 25vw, 72vw'}
                    class="absolute inset-0 h-full"
                  />
                </div>
                <div class="card-shade absolute inset-0" aria-hidden="true" />
                <div class="absolute inset-x-0 bottom-0 p-4 sm:p-5">
                  <h3 class:list={['font-bold text-white', feature ? 'text-xl lg:text-3xl' : 'text-xl']}>
                    {t(category.title, locale)}
                  </h3>
                  <p class:list={['mt-1 text-sm text-white/85', !feature && 'lg:hidden']}>{t(category.description, locale)}</p>
                  <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-orange-light">
                    {t(ui.viewCategory, locale)}
                    <Icon name="arrowRight" class="size-4 transition-transform group-hover:translate-x-1" />
                  </span>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  /* Navy fade at the bottom so white text stays readable on any photo. */
  .card-shade {
    background: linear-gradient(to top, rgb(8 23 87 / 0.95) 0%, rgb(8 23 87 / 0.55) 45%, rgb(8 23 87 / 0.05) 75%);
  }

  ul::-webkit-scrollbar {
    display: none;
  }
</style>
