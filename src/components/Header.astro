---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { getNavigation, getUi } from '../data';
import { localizePath, stripLocale, t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi();
const { main } = getNavigation();
const current = stripLocale(Astro.url.pathname);

const items = main.map((item) => ({
  label: t(item.label, locale),
  href: localizePath(item.href, locale),
  isHome: item.href === '',
  active: item.href === '' ? current === '' : current === item.href || current.startsWith(`${item.href}/`),
}));
---

<header class="sticky top-0 z-40 border-b border-silver bg-white">
  <div class="absolute inset-x-0 -bottom-px h-0.5 origin-left scale-x-0 bg-orange" aria-hidden="true" data-scroll-progress></div>
  <div class="mx-auto flex h-16 max-w-7xl lg:h-20 items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href={localizePath('', locale)} class="shrink-0" aria-label={t(ui.homeLink, locale)}>
      <Logo locale={locale} size="h-[3.25rem] lg:h-16" />
    </a>

    <nav aria-label={t(ui.mainNav, locale)} class="ml-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          items
            .filter((item) => !item.isHome)
            .map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'flex min-h-11 items-center rounded-md px-2.5 text-sm font-medium transition-colors hover:text-navy xl:px-3',
                    item.active ? 'text-navy underline decoration-orange decoration-2 underline-offset-8' : 'text-ink',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>

    <LanguageSwitcher locale={locale} class="ml-auto lg:ml-2" />

    <div class="hidden lg:block">
      <WhatsAppButton locale={locale} label={t(ui.whatsappShort, locale)} class="text-sm" />
    </div>

    <button
      type="button"
      class="-mr-2 inline-flex size-11 items-center justify-center rounded-md text-navy lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <Icon name="menu" class="size-6" data-icon-open />
      <Icon name="close" class="hidden size-6" data-icon-close />
      <span class="sr-only" data-label-open>{t(ui.menuOpen, locale)}</span>
      <span class="sr-only hidden" data-label-close>{t(ui.menuClose, locale)}</span>
    </button>
  </div>

  <nav id="mobile-menu" aria-label={t(ui.mainNav, locale)} class="hidden border-t border-silver bg-white lg:hidden" data-menu>
    <ul class="mx-auto max-w-7xl px-4 py-2 sm:px-6">
      {
        items.map((item) => (
          <li class="border-b border-mist last:border-0">
            <a
              href={item.href}
              aria-current={item.active ? 'page' : undefined}
              class:list={[
                'flex min-h-12 items-center border-l-4 pl-3 font-heading text-lg font-bold',
                item.active ? 'border-orange text-navy' : 'border-transparent text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.classList.toggle('hidden', !open);
    for (const el of toggle.querySelectorAll('[data-icon-open], [data-label-open]')) el.classList.toggle('hidden', open);
    for (const el of toggle.querySelectorAll('[data-icon-close], [data-label-close]')) el.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  matchMedia('(min-width: 64rem)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>
