---
import Icon from './Icon.astro';
import { getUi } from '../data';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

// Clearly labelled stand-in for a real photo. Replace before launch.
interface Props {
  locale: Locale;
  /** What the real photo should show, e.g. "Scania tractor head in yard". */
  description: string;
  /** CSS aspect-ratio, e.g. "16 / 9". */
  ratio?: string;
  class?: string;
}

const { locale, description, ratio = '4 / 3', class: className } = Astro.props;
const ui = getUi();
---

<div
  role="img"
  aria-label={`${t(ui.placeholder, locale)}: ${description}`}
  style={{ aspectRatio: ratio }}
  class:list={[
    'flex flex-col items-center justify-center gap-2 rounded-md border-2 border-dashed border-silver bg-mist p-4 text-center text-slate-600',
    className,
  ]}
>
  <Icon name="image" class="size-8 text-globe" />
  <span class="text-xs font-semibold uppercase tracking-wider">{t(ui.placeholder, locale)}</span>
  <span class="text-sm">{description}</span>
</div>
