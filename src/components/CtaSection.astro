---
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { getSiteSettings } from '../data';
import { localizePath, t } from '../i18n/utils';
import type { Locale } from '../i18n/config';
import type { VideoBackground } from '../data/types';

interface Props {
  locale: Locale;
  /** Optional looping video behind the panel (home page only). */
  background?: VideoBackground;
}

const { locale, background } = Astro.props;
const { cta } = getSiteSettings();

const videos = import.meta.glob<string>('/src/assets/videos/*.mp4', { query: '?url', import: 'default', eager: true });
const videoUrl = background && videos[background.video];
---

<section aria-labelledby="cta-heading" class="bg-white pb-14 lg:pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="on-dark relative isolate grid gap-8 overflow-hidden rounded-md border-t-4 border-orange bg-navy px-6 py-10 text-white sm:px-10 lg:grid-cols-2 lg:items-center lg:px-14 lg:py-14"
    >
      {
        background && (
          <div class="absolute inset-0 -z-10" aria-hidden="true">
            <div class="absolute inset-0" data-parallax>
              <Photo
                image={background.poster}
                locale={locale}
                ratio="16 / 9"
                sizes="(min-width: 1280px) 1216px, 100vw"
                class="absolute inset-0 h-full"
              />
              {/* No src in the HTML: the script below adds it on desktop only, so phones never download it. */}
              {videoUrl && (
                <video
                  class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700"
                  muted
                  loop
                  playsinline
                  preload="none"
                  data-cta-video={videoUrl}
                />
              )}
            </div>
            <div class="cta-shade absolute inset-0" />
          </div>
        )
      }
      <div>
        <h2 id="cta-heading" class="text-3xl font-extrabold text-white sm:text-4xl">{t(cta.heading, locale)}</h2>
        <p class="mt-3 max-w-lg text-lg text-white/85">{t(cta.text, locale)}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <WhatsAppButton locale={locale} class="px-6 py-3 text-base" />
        <a
          href={localizePath(cta.quoteLink.href, locale)}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border-2 border-white/40 bg-navy/40 px-6 py-3 font-semibold text-white btn-motion hover:border-white hover:bg-white/10"
        >
          <Icon name="quote" class="size-5" />
          {t(cta.quoteLink.label, locale)}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Keeps white text well above AA over the brightest frames: solid navy behind the copy. */
  .cta-shade {
    background:
      linear-gradient(to right, rgb(11 31 115 / 0.94) 0%, rgb(11 31 115 / 0.86) 50%, rgb(8 23 87 / 0.72) 100%);
  }
</style>

<script>
  // Desktop only, with motion allowed and no data saver: load the clip once the panel is near,
  // play it while on screen and pause it when scrolled away.
  const video = document.querySelector<HTMLVideoElement>('[data-cta-video]');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (
    video &&
    !saveData &&
    document.documentElement.classList.contains('motion') &&
    matchMedia('(min-width: 64rem)').matches
  ) {
    video.addEventListener('playing', () => video.classList.remove('opacity-0'), { once: true });
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!video.src) video.src = video.dataset.ctaVideo!;
          video.play().catch(() => {});
        } else video.pause();
      },
      { rootMargin: '200px 0px' },
    ).observe(video);
  }
</script>
