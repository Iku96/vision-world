---
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { getSiteSettings } from '../data';
import { localizePath, t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { cta } = getSiteSettings();
---

<section aria-labelledby="cta-heading" class="bg-white pb-14 lg:pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="on-dark grid gap-8 rounded-md border-t-4 border-orange bg-navy px-6 py-10 text-white sm:px-10 lg:grid-cols-2 lg:items-center lg:px-14 lg:py-14"
    >
      <div>
        <h2 id="cta-heading" class="text-3xl font-extrabold text-white sm:text-4xl">{t(cta.heading, locale)}</h2>
        <p class="mt-3 max-w-lg text-lg text-white/85">{t(cta.text, locale)}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:justify-end">
        <WhatsAppButton locale={locale} class="px-6 py-3 text-base" />
        <a
          href={localizePath(cta.quoteLink.href, locale)}
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md border-2 border-white/40 px-6 py-3 font-semibold text-white transition-colors hover:border-white hover:bg-white/10"
        >
          <Icon name="quote" class="size-5" />
          {t(cta.quoteLink.label, locale)}
        </a>
      </div>
    </div>
  </div>
</section>
