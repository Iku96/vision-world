---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import CtaSection from '../components/CtaSection.astro';
import { getAboutPage, getSiteSettings } from '../data';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = getAboutPage();
const { ceo } = getSiteSettings();
---

<BaseLayout title={t(page.seo.title, locale)} description={t(page.seo.description, locale)}>
  <PageHeader
    locale={locale}
    eyebrow={t(page.header.eyebrow, locale)}
    heading={t(page.header.heading, locale)}
    intro={t(page.header.intro, locale)}
  />

  <section aria-labelledby="story-heading" class="bg-white py-14 lg:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16 lg:px-8">
      <div class="lg:col-span-7">
        <h2 id="story-heading" class="text-3xl font-extrabold sm:text-4xl">{t(page.story.heading, locale)}</h2>
        <div class="mt-5 space-y-4 text-lg leading-relaxed text-slate-700">
          {page.story.paragraphs.map((p) => <p>{t(p, locale)}</p>)}
        </div>
      </div>
      <div class="grid gap-4 self-start lg:col-span-5">
        {
          [page.mission, page.vision].map((item) => (
            <div class="rounded-md border-l-4 border-orange bg-mist p-6">
              <h3 class="text-xl font-bold">{t(item.title, locale)}</h3>
              <p class="mt-2 leading-relaxed text-slate-700">{t(item.text, locale)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section aria-labelledby="ceo-heading" class="bg-mist py-14 lg:py-20">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:gap-16 lg:px-8">
      <div class="mx-auto w-full max-w-sm lg:col-span-5 lg:max-w-none">
        <Photo image={page.ceo.image} locale={locale} ratio="4 / 5" sizes="(min-width: 1024px) 480px, 384px" class="rounded-md" />
      </div>
      <div class="lg:col-span-7">
        <p class="flex items-center gap-2 text-sm font-semibold tracking-wider text-globe-dark uppercase">
          <span class="h-0.5 w-6 bg-orange" aria-hidden="true"></span>
          {t(page.ceo.eyebrow, locale)}
        </p>
        <h2 id="ceo-heading" class="mt-3 text-3xl font-extrabold sm:text-4xl">{t(page.ceo.heading, locale)}</h2>
        <p class="mt-2 text-lg font-semibold text-navy">{ceo.name}, {t(ceo.role, locale)}</p>
        <p class="mt-5 rounded-md border-2 border-dashed border-silver bg-white p-5 text-lg leading-relaxed text-slate-700">
          {t(page.ceo.story, locale)}
        </p>
        <figure class="mt-8 border-l-4 border-orange pl-5">
          <blockquote class="font-heading text-xl leading-snug font-bold text-navy sm:text-2xl">
            <p>{t(page.ceo.quote, locale)}</p>
          </blockquote>
          <figcaption class="mt-3 text-sm">
            <span class="font-semibold">{ceo.name}</span>, {t(ceo.role, locale)}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section aria-labelledby="values-heading" class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="values-heading" class="text-3xl font-extrabold sm:text-4xl">{t(page.values.heading, locale)}</h2>
      <p class="mt-3 text-lg text-slate-700">{t(page.values.intro, locale)}</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          page.values.items.map((value, i) => (
            <li class="lift rounded-md border border-silver p-6">
              <span class="font-heading text-sm font-bold text-orange" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 text-xl font-bold">{t(value.title, locale)}</h3>
              <p class="mt-2 text-slate-700">{t(value.text, locale)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>
