---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { getCategories, getContactPage, getSiteSettings, getWhatsappUrl } from '../data';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = getContactPage();
const { contact } = getSiteSettings();
const { form } = page;
const categories = getCategories();
const isPlaceholder = (value: string) => value.startsWith('[');
const mapUrl = `https://www.google.com/maps?q=${encodeURIComponent(contact.mapQuery)}&output=embed`;

const inputClass =
  'mt-1 block min-h-11 w-full rounded-md border border-silver bg-white px-3 py-2 text-base text-ink placeholder:text-slate-500 focus:border-globe-dark';
const required = `(${t(form.required, locale)})`;
const optional = `(${t(form.optional, locale)})`;
---

<BaseLayout title={t(page.seo.title, locale)} description={t(page.seo.description, locale)}>
  <PageHeader
    locale={locale}
    eyebrow={t(page.header.eyebrow, locale)}
    heading={t(page.header.heading, locale)}
    intro={t(page.header.intro, locale)}
  />

  <section class="bg-mist py-12 lg:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12 lg:px-8">
      <!-- WhatsApp, details and map -->
      <div class="space-y-6 lg:col-span-5">
        <div class="on-dark rounded-md border-t-4 border-orange bg-navy p-6 text-white">
          <h2 class="text-2xl font-extrabold text-white">{t(page.whatsapp.title, locale)}</h2>
          <p class="mt-2 text-white/85">{t(page.whatsapp.text, locale)}</p>
          <WhatsAppButton locale={locale} class="mt-5 w-full px-6 text-base sm:w-auto" />
        </div>

        <div class="rounded-md bg-white p-6">
          <h2 class="text-xl font-bold">{t(page.detailsHeading, locale)}</h2>
          <ul class="mt-4 space-y-3">
            <li class="flex items-center gap-3">
              <Icon name="whatsapp" class="size-5 shrink-0 text-globe-dark" />
              <a href={getWhatsappUrl(locale)} target="_blank" rel="noopener" class="inline-flex min-h-11 items-center hover:underline">
                {contact.whatsappNumber}
              </a>
            </li>
            <li class="flex items-center gap-3">
              <Icon name="phone" class="size-5 shrink-0 text-globe-dark" />
              {
                isPlaceholder(contact.phone) ? (
                  <span>{contact.phone}</span>
                ) : (
                  <a href={`tel:${contact.phone.replace(/\s/g, '')}`} class="inline-flex min-h-11 items-center hover:underline">{contact.phone}</a>
                )
              }
            </li>
            <li class="flex items-center gap-3">
              <Icon name="mail" class="size-5 shrink-0 text-globe-dark" />
              {
                isPlaceholder(contact.email) ? (
                  <span>{contact.email}</span>
                ) : (
                  <a href={`mailto:${contact.email}`} class="inline-flex min-h-11 items-center hover:underline">{contact.email}</a>
                )
              }
            </li>
            <li class="flex gap-3">
              <Icon name="pin" class="mt-0.5 size-5 shrink-0 text-globe-dark" />
              <span>{t(contact.address, locale)}</span>
            </li>
            <li class="flex gap-3">
              <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-globe-dark" />
              <span>{t(contact.hours, locale)}</span>
            </li>
          </ul>
        </div>

        <div class="overflow-hidden rounded-md bg-white">
          <iframe
            src={mapUrl}
            title={t(page.mapTitle, locale)}
            class="block aspect-[4/3] w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>

      <!-- Quote form (demo: not connected) -->
      <div class="rounded-md bg-white p-6 sm:p-8 lg:col-span-7" id="quote">
        <h2 class="text-2xl font-extrabold sm:text-3xl">{t(form.heading, locale)}</h2>
        <p class="mt-2 text-slate-700">{t(form.intro, locale)}</p>

        <form class="mt-6 grid gap-5 sm:grid-cols-2" data-quote-form novalidate>
          <label class="block font-semibold sm:col-span-2">
            {t(form.name, locale)} <span class="font-normal text-slate-600">{required}</span>
            <input type="text" name="name" autocomplete="name" required class={inputClass} />
          </label>
          <label class="block font-semibold">
            {t(form.phone, locale)} <span class="font-normal text-slate-600">{required}</span>
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required class={inputClass} />
          </label>
          <label class="block font-semibold">
            {t(form.email, locale)} <span class="font-normal text-slate-600">{optional}</span>
            <input type="email" name="email" autocomplete="email" class={inputClass} />
          </label>
          <label class="block font-semibold sm:col-span-2">
            {t(form.need, locale)} <span class="font-normal text-slate-600">{required}</span>
            <input
              type="text"
              name="need"
              required
              placeholder={t(form.needHint, locale)}
              aria-describedby="need-hint"
              class={inputClass}
            />
            <span id="need-hint" class="sr-only">{t(form.needHint, locale)}</span>
          </label>
          <label class="block font-semibold sm:col-span-2">
            {t(form.category, locale)} <span class="font-normal text-slate-600">{optional}</span>
            <select name="category" class={inputClass}>
              <option value="">{t(form.categoryPlaceholder, locale)}</option>
              {categories.map((c) => <option value={c.slug.current}>{t(c.title, locale)}</option>)}
              <option value="other">{t(form.categoryOther, locale)}</option>
            </select>
          </label>
          <label class="block font-semibold sm:col-span-2">
            {t(form.message, locale)} <span class="font-normal text-slate-600">{optional}</span>
            <textarea name="message" rows="5" class:list={[inputClass, 'min-h-32']}></textarea>
          </label>

          <div class="sm:col-span-2">
            <button
              type="submit"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-md bg-navy px-8 text-base font-semibold text-white transition-colors hover:bg-navy-dark sm:w-auto"
            >
              {t(form.submit, locale)}
            </button>
          </div>

          <div
            class="hidden rounded-md border-l-4 border-orange bg-mist p-4 sm:col-span-2"
            role="status"
            tabindex="-1"
            data-demo-message
          >
            <p>{t(form.demoMessage, locale)}</p>
            <WhatsAppButton locale={locale} class="mt-3 px-6" />
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  const notice = document.querySelector<HTMLElement>('[data-demo-message]');

  if (form && notice) {
    // Preselect the category when arriving from a category or listing page (?category=trucks).
    const category = form.elements.namedItem('category') as HTMLSelectElement;
    const preset = new URLSearchParams(location.search).get('category');
    if (preset && [...category.options].some((o) => o.value === preset)) category.value = preset;

    // Demo: validate, then explain that nothing was sent instead of submitting.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      notice.classList.remove('hidden');
      notice.focus();
    });
  }
</script>
