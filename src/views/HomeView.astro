---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import Hero from '../components/home/Hero.astro';
import TradeSection from '../components/home/TradeSection.astro';
import StockSection from '../components/home/StockSection.astro';
import HowWeWorkSection from '../components/home/HowWeWorkSection.astro';
import AboutSection from '../components/home/AboutSection.astro';
import GroupSection from '../components/home/GroupSection.astro';
import CtaSection from '../components/home/CtaSection.astro';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout>
  <OrganizationJsonLd slot="head" locale={locale} />
  <Hero locale={locale} />
  <TradeSection locale={locale} />
  <StockSection locale={locale} />
  <HowWeWorkSection locale={locale} />
  <AboutSection locale={locale} />
  <GroupSection locale={locale} />
  <CtaSection locale={locale} />
</BaseLayout>
