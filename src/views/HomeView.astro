---
// Temporary: shell only, so the shared layout can be reviewed.
// Home page sections are built after layout approval.
import BaseLayout from '../layouts/BaseLayout.astro';
import OrganizationJsonLd from '../components/OrganizationJsonLd.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout>
  <OrganizationJsonLd slot="head" locale={locale} />
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-20">
    <PlaceholderImage locale={locale} description="Home page sections go here after layout review" ratio="16 / 9" />
  </div>
</BaseLayout>
