---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import CtaSection from '../components/CtaSection.astro';
import { getBuyerJourney, getHowWeWorkPage, getUi } from '../data';
import { t } from '../i18n/utils';
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = getHowWeWorkPage();
const ui = getUi();
const steps = getBuyerJourney();
---

<BaseLayout title={t(page.seo.title, locale)} description={t(page.seo.description, locale)}>
  <PageHeader
    locale={locale}
    eyebrow={t(page.header.eyebrow, locale)}
    heading={t(page.header.heading, locale)}
    intro={t(page.header.intro, locale)}
  />

  <section class="bg-white py-14 lg:py-20">
    <ol class="mx-auto grid max-w-5xl gap-10 px-4 sm:px-6 lg:px-8">
      {
        steps.map((step, i) => (
          <li class="relative grid gap-4 pl-16 sm:pl-20">
            {/* Orange route line joining the steps. */}
            {i < steps.length - 1 && (
              <span class="absolute top-14 -bottom-10 left-6 w-0.5 bg-orange sm:left-7" aria-hidden="true" />
            )}
            <span
              class="absolute top-0 left-0 flex size-12 items-center justify-center rounded-full bg-navy text-white sm:size-14"
              aria-hidden="true"
            >
              <Icon name={step.icon} class="size-6" />
            </span>
            <div>
              <p class="text-sm font-semibold tracking-wider text-globe-dark uppercase">
                {t(ui.step, locale)} {i + 1}
              </p>
              <h2 class="mt-1 text-2xl font-extrabold sm:text-3xl">{t(step.title, locale)}</h2>
              <p class="mt-3 text-lg leading-relaxed text-slate-700">{t(step.description, locale)}</p>
              <ul class="mt-4 space-y-2">
                {step.details.map((d) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-orange" aria-hidden="true" />
                    <span class="text-slate-700">{t(d, locale)}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="faq-heading" class="bg-mist py-14 lg:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="text-3xl font-extrabold sm:text-4xl">{t(page.faq.heading, locale)}</h2>
      <p class="mt-3 text-lg text-slate-700">{t(page.faq.intro, locale)}</p>
      <div class="mt-8 divide-y divide-silver rounded-md border border-silver bg-white">
        {
          page.faq.items.map((item) => (
            <details class="group">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 font-heading text-lg font-bold text-navy [&::-webkit-details-marker]:hidden">
                {t(item.question, locale)}
                <span
                  class="flex size-8 shrink-0 items-center justify-center rounded-full bg-mist text-navy transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <p class="px-5 pb-5 leading-relaxed text-slate-700">{t(item.answer, locale)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection locale={locale} />
</BaseLayout>
