---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SEO, { type SeoProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import ScrollMotion from '../components/ScrollMotion.astro';
import { getUi } from '../data';
import { localeMeta } from '../i18n/config';
import { getLocale, t } from '../i18n/utils';

type Props = SeoProps;

const locale = getLocale(Astro.currentLocale);
const ui = getUi();
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f73" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-archivo" preload={[{ weight: 800 }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <SEO locale={locale} {...Astro.props} />
    <slot name="head" />
    <!-- Enable scroll reveals before first paint, unless the visitor prefers reduced motion. -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body id="top" class="flex min-h-dvh flex-col pb-[calc(4.25rem+env(safe-area-inset-bottom))] lg:pb-0">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-navy px-4 py-2 font-semibold text-white focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
    >
      {t(ui.skipToContent, locale)}
    </a>
    <PreviewBanner locale={locale} />
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <MobileCtaBar locale={locale} />
    <BackToTop locale={locale} />
    <ScrollMotion />
  </body>
</html>
